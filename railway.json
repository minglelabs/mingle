{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway",
    "watchPatterns": [
      "railway.json",
      "Dockerfile.railway",
      ".dockerignore",
      "railway/**",
      "mingle-app/**",
      "mingle-stt/**",
      "mingle-messaging/**"
    ]
  },
  "deploy": {
    "startCommand": "node railway/start-single-service.mjs",
    "healthcheckPath": "/railway/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "multiRegionConfig": {
      "asia-southeast1-eqsg3a": {
        "numReplicas": 1
      }
    }
  }
}
