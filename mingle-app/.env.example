# Core auth
AUTH_SECRET=

# Admin feedback inbox (/admin)
MINGLE_ADMIN_USERNAME=
MINGLE_ADMIN_PASSWORD=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple OAuth
# client id (Service ID for web Sign in with Apple)
AUTH_APPLE_ID=

# Option A: provide pre-generated client secret JWT directly
AUTH_APPLE_SECRET=

# Option B: provide key materials and let server generate AUTH_APPLE_SECRET
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
# Paste p8 content with escaped newlines, for example:
# AUTH_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_APPLE_PRIVATE_KEY=
# optional (max 15552000 = 180 days), default: 15465600 (179 days)
AUTH_APPLE_CLIENT_SECRET_TTL_SECONDS=15465600

# Apple native auth (iOS NativeAuthModule - Apple ID token audience 검증)
# AUTH_APPLE_NATIVE_AUDIENCES: 쉼표 구분 허용 audience 목록. 미설정 시 native Apple 로그인 500 에러 발생.
# 일반적으로 번들 ID (예: com.minglelabs.mingle.rn)를 설정.
AUTH_APPLE_NATIVE_AUDIENCES=
# AUTH_APPLE_NATIVE_ID / AUTH_APPLE_BUNDLE_ID 중 하나로도 설정 가능 (AUTH_APPLE_NATIVE_AUDIENCES 없을 때 폴백)
AUTH_APPLE_NATIVE_ID=
AUTH_APPLE_BUNDLE_ID=

# NextAuth / app URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MINGLE_LEGACY_SITE_URL=https://mingle-1-1-4-production.up.railway.app
MINGLE_API_FALLBACK_SITE_URL=https://mingle-1-1-4-production.up.railway.app

# Email auth (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# optional (default: 30)
EMAIL_RESET_TOKEN_TTL_MINUTES=30

# RN runtime
# iOS build: NEXT_PUBLIC_API_NAMESPACE=ios/v1.1.0
# Android build: NEXT_PUBLIC_API_NAMESPACE=android/v1.1.0
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3001
# Single-service Railway deploys use the same public host and route WebSocket traffic through this path.
NEXT_PUBLIC_WS_PATH=
MINGLE_LEGACY_WS_URL=wss://mingle-1-1-4-production.up.railway.app/stt
MINGLE_STT_FALLBACK_WS_URL=wss://mingle-1-1-4-production.up.railway.app/stt
NEXT_PUBLIC_API_NAMESPACE=ios/v1.1.0

# Translation provider
# Default: Gemini
TRANSLATE_PROVIDER=gemini
# Optional override. Defaults:
# - Gemini: gemini-2.5-flash-lite
# - Qwen via OpenAI-compatible APIs: Qwen/Qwen3.5-9B
# - Qwen via DashScope: Qwen3.5-9B
TRANSLATE_MODEL=

# For Qwen or any OpenAI-compatible translation backend
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=

# Optional JSON object merged into the request body sent to the OpenAI-compatible backend.
# Examples:
# - OpenRouter / Together / vLLM / SGLang:
#   {"chat_template_kwargs":{"enable_thinking":false}}
# - DashScope:
#   {"enable_thinking":false}
TRANSLATE_EXTRA_BODY=

# Optional provider-specific API keys. If TRANSLATE_BASE_URL / TRANSLATE_API_KEY
# are omitted, the server infers these defaults:
# - OPENROUTER_API_KEY -> https://openrouter.ai/api/v1
# - TOGETHER_API_KEY -> https://api.together.xyz/v1
# - DASHSCOPE_API_KEY -> https://dashscope.aliyuncs.com/compatible-mode/v1
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
DASHSCOPE_API_KEY=

# Client version policy
# If IOS_CLIENT_MIN_SUPPORTED_VERSION is missing or invalid, iOS policy fails closed to force_update.
IOS_CLIENT_MIN_SUPPORTED_VERSION=
IOS_CLIENT_RECOMMENDED_BELOW_VERSION=
IOS_CLIENT_LATEST_VERSION=
IOS_APPSTORE_URL=https://apps.apple.com/app/id6759795134

# If Android env is omitted, Android policy falls back to iOS env.
ANDROID_CLIENT_MIN_SUPPORTED_VERSION=
ANDROID_CLIENT_RECOMMENDED_BELOW_VERSION=
ANDROID_CLIENT_LATEST_VERSION=
ANDROID_PLAYSTORE_URL=https://play.google.com/store/apps/details?id=com.minglelabs.mingle.rn

# Optional runtime AdMob banner unit overrides returned by /api/*/client/version-policy.
# If omitted, the mobile apps keep their built-in production banner unit IDs.
RN_ADMOB_BANNER_UNIT_ID_IOS=
RN_ADMOB_BANNER_UNIT_ID_ANDROID=

# Admin dashboard (/admin/dashboard)
# Required for deploy markers (vertical lines on the charts, auto-derived from
# minglelabs/mingle's commit history). Uses GitHub's GraphQL API, which has no
# unauthenticated tier, so without this token markers are silently disabled -- the
# rest of the dashboard still works. Needs a fine-grained PAT with read-only "Contents"
# access to minglelabs/mingle (or a classic token with `repo` scope for a private repo).
# One GraphQL request covers all watched paths per refresh, cached in-process for an
# hour, so this stays at 1 GitHub API call/hour regardless of dashboard traffic.
GITHUB_TOKEN=
