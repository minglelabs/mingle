<?xml version="1.0" encoding="utf-8"?>
<!-- Sharing shortcuts: conversations published by NativeShareTargetModule
     appear as direct-share targets for these content types. The category
     must match SHARE_TARGET_CATEGORY in that module. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.minglelabs.mingle.rn.MainActivity">
        <data android:mimeType="image/*" />
        <category android:name="com.minglelabs.mingle.rn.category.SHARE_TARGET" />
    </share-target>
    <share-target android:targetClass="com.minglelabs.mingle.rn.MainActivity">
        <data android:mimeType="text/plain" />
        <category android:name="com.minglelabs.mingle.rn.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
