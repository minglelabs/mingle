{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!app-ads\\.txt$).*)",
      "has": [
        {
          "type": "host",
          "value": "translator.minglelabs.app"
        }
      ],
      "destination": "https://hashchat.minglelabs.app/:path",
      "permanent": true
    },
    {
      "source": "/:page(privacy-policy|terms-of-use).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/:locale(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|th|vi|zh-cn|zh-tw)/:page(privacy-policy|terms-of-use).html",
      "destination": "/:locale/:page",
      "permanent": true
    },
    {
      "source": "/:page(privacy-policy|terms-of-use)/:locale(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|th|vi|zh-cn|zh-tw)",
      "destination": "/:locale/:page",
      "permanent": true
    },
    {
      "source": "/legal/:page(privacy-policy|terms-of-use).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/legal/:locale(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|th|vi|zh-cn|zh-tw)/:page(privacy-policy|terms-of-use).html",
      "destination": "/:locale/:page",
      "permanent": true
    },
    {
      "source": "/legal/:page(privacy-policy|terms-of-use)",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/legal/:locale(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|th|vi|zh-cn|zh-tw)/:page(privacy-policy|terms-of-use)",
      "destination": "/:locale/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/landing/:version(normal|social|gaming)",
      "destination": "https://mingle-landing.vercel.app/landing/:version"
    },
    {
      "source": "/landing/:version(normal|social|gaming)/:path*",
      "destination": "https://mingle-landing.vercel.app/landing/:version/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://mingle-landing.vercel.app/_next/:path*"
    },
    {
      "source": "/api/web/landing/v1/:path*",
      "destination": "https://mingle-landing.vercel.app/api/web/landing/v1/:path*"
    },
    {
      "source": "/:asset(chat_by_bear.png|chat_by_cat.png|demo_app.mp4|demo_conversation.mp4|favicon.ico|gaming-hero.png|horizontal1.png|horizontal2.png|image.png|og-image.png|social-hero.jpeg|world-map.png)",
      "destination": "https://mingle-landing.vercel.app/:asset"
    },
    {
      "source": "/blogs",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<lang>ko|ja|zh-cn|zh-tw|fr|de|es|pt|it|ru|ar|hi|th|vi)"
        }
      ],
      "destination": "/blogs/:lang"
    },
    {
      "source": "/blogs/:slug(ai-wrapper-business|ai-wrapper-business-surfers-3rd|hashchat-pitch-deck|hashchat-pitch-deck-short|virtually-deck|hashchat-social-network|ai-translators-comparison)",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<lang>ko|ja|zh-cn|zh-tw|fr|de|es|pt|it|ru|ar|hi|th|vi)"
        }
      ],
      "destination": "/blogs/:lang/:slug"
    },
    {
      "source": "/blogs",
      "destination": "/blogs/en"
    },
    {
      "source": "/blogs/:slug(ai-wrapper-business|ai-wrapper-business-surfers-3rd|hashchat-pitch-deck|hashchat-pitch-deck-short|virtually-deck)",
      "destination": "/blogs/en/:slug"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/blogs/:slug.html"
    },
    {
      "source": "/legal",
      "destination": "/legal-index"
    },
    {
      "source": "/legal/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/:page(privacy-policy|terms-of-use)",
      "destination": "/:page.html"
    },
    {
      "source": "/:locale(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|th|vi|zh-cn|zh-tw)/:page(privacy-policy|terms-of-use)",
      "destination": "/:locale/:page.html"
    },
    {
      "source": "/:locale(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|th|vi|zh-cn|zh-tw)",
      "destination": "/legal-index"
    },
    {
      "source": "/landing",
      "destination": "/"
    },
    {
      "source": "/landing/:locale(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|th|vi|zh-CN|zh-TW|zh-cn|zh-tw)",
      "destination": "/"
    }
  ]
}
